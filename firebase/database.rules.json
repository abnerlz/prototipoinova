{
  "rules": {
    ".read": false,
    ".write": false,
    "sensor_readings": {
      ".read": true,
      ".indexOn": ["sensor_id"],
      "$readingId": {
        ".write": "auth != null && auth.token.email == 'esp32-device@example.com' && !data.exists()",
        ".validate": "newData.hasChildren(['sensor_id', 'umidade_solo', 'inclinacao', 'vibracao', 'chuva', 'created_at'])",
        "sensor_id": {
          ".validate": "newData.isString() && newData.val() == 'SENSOR-001'"
        },
        "umidade_solo": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "inclinacao": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 90"
        },
        "vibracao": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "chuva": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
        },
        "created_at": {
          ".validate": "newData.isString()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
