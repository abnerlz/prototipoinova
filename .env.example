# Firebase Realtime Database. O site Vercel lê o banco diretamente pelo SDK web.
VITE_FIREBASE_DATABASE_URL=https://proterra-sensors-default-rtdb.firebaseio.com/
# Usada apenas pelos endpoints server-side legados do Vercel.
FIREBASE_DATABASE_URL=https://proterra-sensors-default-rtdb.firebaseio.com/

# Credencial para endpoints server-side legados; o sketch ESP32 direto não usa esta variável.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Chave apenas para a recepção legada POST /api/sensores no Vercel.
# O novo fluxo ESP32 -> Firebase usa Firebase Authentication e não usa esta variável.
SENSOR_API_KEY=
