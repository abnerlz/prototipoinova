# Firebase Realtime Database (URL pública do banco do projeto)
VITE_FIREBASE_DATABASE_URL=https://proterra-sensors-default-rtdb.firebaseio.com/
FIREBASE_DATABASE_URL=https://proterra-sensors-default-rtdb.firebaseio.com/

# No deploy fora do Google Cloud, configure uma credencial de conta de serviço
# no ambiente do servidor; nunca use prefixo VITE_ para esse valor.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Segredo compartilhado entre o ESP32 e a rota POST /api/sensores
SENSOR_API_KEY=
