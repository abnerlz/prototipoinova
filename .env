# Configurações do Firebase Realtime Database
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://proterra-sensors-default-rtdb.firebaseio.com/

# Se o seu código do v0/Firebase também pedir a API Key ou Project ID, adicione aqui:
# NEXT_PUBLIC_FIREBASE_API_KEY=sua_api_key_aqui
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=proterra-sensors